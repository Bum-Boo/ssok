; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="ssok"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Language="*res://src/ui/ssok_locale.gd"

[internationalization]

locale/translations=PackedStringArray("res://assets/locales/ko.po", "res://assets/locales/zh_CN.po", "res://assets/locales/ja.po")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[physics]

3d/solver/solver_iterations=64
3d/solver/contact_max_allowed_penetration=0.001
3d/solver/contact_recycle_radius=0.001
3d/solver/contact_max_separation=0.005
