[gd_resource type="Resource" script_class="PartDef" format=3]

[ext_resource type="ArrayMesh" path="res://assets/meshes/servo.res" id="1_xa34u"]
[ext_resource type="Script" path="res://src/core/port.gd" id="2_myofs"]
[ext_resource type="Script" path="res://src/core/part_def.gd" id="3_2n8ii"]

[sub_resource type="Resource" id="Resource_ibyws"]
script = ExtResource("2_myofs")
id = &"mount_bottom"
local_position = Vector3(0, -0.015, 0)
local_normal = Vector3(0, -1, 0)
tag = &"servo_mount"
accepts = Array[StringName]([&"base_mount"])

[sub_resource type="Resource" id="Resource_owkwf"]
script = ExtResource("2_myofs")
id = &"output_shaft"
local_position = Vector3(0.0115, 0.005, 0)
local_normal = Vector3(1, 0, 0)
tag = &"servo_output"
accepts = Array[StringName]([&"arm_mount"])
rotates = true

[sub_resource type="Resource" id="Resource_ld2no"]
script = ExtResource("2_myofs")
id = &"signal_pin"
kind = 1
local_position = Vector3(-0.0115, 0, 0)
local_normal = Vector3(-1, 0, 0)
tag = &"pwm_signal"
accepts = Array[StringName]([&"board_digital_pwm"])

[resource]
script = ExtResource("3_2n8ii")
id = &"torque_micro_servo"
display_name = "Torque Micro Servo"
mesh = ExtResource("1_xa34u")
ports = Array[ExtResource("2_myofs")]([SubResource("Resource_ibyws"), SubResource("Resource_owkwf"), SubResource("Resource_ld2no")])
mass_kg = 0.02
actuator_torque_nm = 0.25
actuator_drives_connected_body = true
merge_fixed_connections = true
