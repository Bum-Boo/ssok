msgstr ""
"Language: zh_CN\n"
"Content-Type: text/plain; charset=UTF-8\n"
"MIME-Version: 1.0\n"

msgid "ssok - robot workshop"
msgstr "ssok - 机器人工作室"

msgid "Language"
msgstr "语言"

msgid "Language changed, but the preference could not be saved."
msgstr "语言已切换，但无法保存设置。"

msgid "Run mode (physics)"
msgstr "运行模式（物理）"

msgid "Control: WASD / gamepad movement"
msgstr "控制：WASD / 手柄移动"

msgid "Control: Learner code"
msgstr "控制：编写的代码"

msgid "Run code"
msgstr "运行代码"

msgid "Stop input / code"
msgstr "停止控制 / 代码"

msgid "AI motion lab"
msgstr "AI 动作实验室"

msgid "Parts"
msgstr "零件"

msgid "Delete selected"
msgstr "删除所选零件"

msgid "Answer: servo arm"
msgstr "示例：舵机机械臂"

msgid "Answer: biped"
msgstr "示例：双足机器人"

msgid "Delete selected part?"
msgstr "删除所选零件？"

msgid "Remove the part and its connections? Ctrl+Z restores them."
msgstr "删除零件及其连接。可用 Ctrl+Z 恢复。"

msgid "OK"
msgstr "确定"

msgid "Cancel"
msgstr "取消"

msgid "Close"
msgstr "关闭"

msgid "Arduino Uno R3"
msgstr "Arduino Uno R3"

msgid "Board (placeholder)"
msgstr "开发板（占位）"

msgid "Leg Link"
msgstr "腿部连杆"

msgid "Wheel 65 mm"
msgstr "轮子 65 mm"

msgid "TT Gear Motor"
msgstr "TT 减速电机"

msgid "HC-SR04 Ultrasonic"
msgstr "HC-SR04 超声波传感器"

msgid "Servo Angle Bracket"
msgstr "舵机直角支架"

msgid "Foot"
msgstr "脚掌"

msgid "Chassis Plate 120 mm"
msgstr "底盘板 120 mm"

msgid "Servo Motor"
msgstr "舵机"

msgid "Arm Link"
msgstr "机械臂连杆"

msgid "Biped Body"
msgstr "双足机器人机身"

msgid "Base Plate"
msgstr "底板"

msgid "Edit mode - select a part, then G to move or R to rotate; connections snap at ports"
msgstr "编辑模式：选择零件，G 移动，R 旋转；接口靠近时自动吸附。"

msgid "running line %d"
msgstr "正在执行第 %d 行"

msgid "finished"
msgstr "执行完毕"

msgid "line %d: %s"
msgstr "第 %d 行：%s"

msgid "Added %s - G to move, R to rotate, Enter to confirm"
msgstr "已添加 %s：G 移动，R 旋转，Enter 确认"

msgid "Return to edit mode and finish the current transform before deleting"
msgstr "请返回编辑模式并结束当前变换后再删除。"

msgid "part removed"
msgstr "零件已删除"

msgid "click a part first, then delete it"
msgstr "请先点击要删除的零件。"

msgid "answer loaded - the finished servo arm"
msgstr "示例已加载：完成的舵机机械臂"

msgid "Biped loaded - Run mode for WASD / stick movement, or Run code for the stepping example"
msgstr "双足机器人已加载：运行模式下用 WASD / 摇杆移动，或运行代码体验踏步示例"

msgid "Edit mode - G move / R rotate / X,Y,Z constrain / Esc cancel"
msgstr "编辑模式：G 移动 / R 旋转 / X,Y,Z 约束轴 / Esc 取消"

msgid "W/S forward/back · A/D turn · left stick · Space stop"
msgstr "W/S 前进·后退 · A/D 转向 · 左摇杆 · Space 停止"

msgid "Code control - press Run code; movement inputs are disabled"
msgstr "代码控制：点击运行代码；移动输入已禁用。"

msgid "Input stopped - servos hold their last targets; return to edit mode to reset the robot"
msgstr "输入已停止：舵机保持最后目标；返回编辑模式可重置机器人。"

msgid "Motion lab closed. Movement remains stopped; select WASD control or toggle Run mode when ready."
msgstr "实验室已关闭，移动仍停止。准备好后选择 WASD 控制或切换运行模式。"

msgid "Evaluated parameters applied to the WASD program; assembly and learner source are unchanged"
msgstr "已将评估参数应用到 WASD 程序；装配和编写的代码未更改。"

msgid "Assembly changed: evaluated motion parameters reset to the experimental defaults. Search again for this graph."
msgstr "装配已更改：动作参数已恢复实验默认值。请根据当前装配重新搜索。"

msgid "MMB orbit · Shift+MMB pan · wheel zoom · Numpad 1/3/7 views · Numpad . frame"
msgstr "鼠标中键：环绕 · Shift+中键：平移 · 滚轮：缩放 · 小键盘 1/3/7：视图 · 小键盘 .：聚焦"

msgid "LMB select · G move / R rotate · X/Y/Z axis · number: mm / degrees · Enter/LMB confirm · Esc/RMB cancel · Ctrl+Z undo"
msgstr "左键：选择 · G 移动 / R 旋转 · X/Y/Z 轴 · 数值：mm / 度 · Enter/左键：确认 · Esc/右键：取消 · Ctrl+Z 撤销"

msgid "W/S forward/back · A/D turn · left stick · Space/gamepad A brake · Esc stop input"
msgstr "W/S 前进·后退 · A/D 转向 · 左摇杆 · Space/手柄 A 制动 · Esc 停止输入"

msgid "Code control · Run code to start · Stop input / code to cancel · Esc stops"
msgstr "代码控制 · 运行代码以开始 · 停止控制 / 代码以取消 · Esc 停止"

msgid "Choose a control source, then enter Run mode.\nPart dimensions are fixed; G uses mm and R uses degrees."
msgstr "选择控制方式，然后进入运行模式。\n零件尺寸固定；G 使用 mm，R 使用度。"

msgid "Code owns the motors. Keyboard/gamepad control is off."
msgstr "代码正在控制电机。键盘/手柄控制已关闭。"

msgid "Load Answer: biped for the movement example."
msgstr "请加载“双足机器人”示例体验移动。"

msgid "Keyboard ready · no gamepad detected"
msgstr "键盘就绪 · 未检测到手柄"

msgid "Gamepad: %s"
msgstr "手柄：%s"

msgid "Biped demo: experimental gait (slow / drift)\nForward %+.2f · Turn %+.2f\n%s"
msgstr "双足示例：实验步态（缓慢 / 漂移）\n前后 %+.2f · 转向 %+.2f\n%s"

msgid "ssok - AI motion lab"
msgstr "ssok - AI 动作实验室"

msgid "Motion search - wired biped"
msgstr "动作搜索：已接线的双足机器人"

msgid "Propose parameters -> simulate -> compare -> explicitly apply. This does not train GPT weights. Other robot programs are not supported yet."
msgstr "提出参数 → 模拟 → 比较 → 手动应用。这不会训练 GPT 权重。目前不支持其他机器人程序。"

msgid "Bridge origin (loopback HTTP / deployed HTTPS)"
msgstr "桥接服务地址（本机 HTTP / 部署的 HTTPS）"

msgid "Bridge bearer token - RAM only. Never enter an OpenAI API key here."
msgstr "桥接服务令牌：仅存于内存。不要在此输入 OpenAI API 密钥。"

msgid "Token from your local bridge terminal"
msgstr "本机桥接服务终端中的令牌"

msgid "Check connection"
msgstr "检查连接"

msgid "Disconnect / forget"
msgstr "断开 / 清除记录"

msgid "Recover from an unavailable bridge. Forgetting does not cancel a remote job."
msgstr "从桥接连接异常中恢复。清除记录不会取消远程任务。"

msgid "Forget local search status?"
msgstr "清除本地搜索状态？"

msgid "This only disconnects the local UI. It does NOT cancel a search on the bridge.\nA submitted job may still run and API charges may continue.\nCheck or stop the bridge before starting another paid search.\nLocal connection status and pending results will be cleared."
msgstr "这只断开本地界面，不会取消桥接服务上的搜索。\n已提交的任务可能继续运行并产生 API 费用。\n再次付费搜索前，请检查或停止桥接服务。\n本地连接状态和待处理结果将被清除。"

msgid "Not connected. OPENAI_API_KEY is configured only on the bridge."
msgstr "未连接。OPENAI_API_KEY 仅在桥接服务中配置。"

msgid "Goal (sent to the bridge/model along with this assembly snapshot)"
msgstr "目标（与装配快照一起发送给桥接服务/模型）"

msgid "Walk forward while staying upright and reducing drift"
msgstr "保持直立并减少漂移，向前行走"

msgid "Evaluate: forward (W)"
msgstr "评估：前进（W）"

msgid "Evaluate: backward (S)"
msgstr "评估：后退（S）"

msgid "Evaluate: turn left (A)"
msgstr "评估：左转（A）"

msgid "Evaluate: turn right (D)"
msgstr "评估：右转（D）"

msgid "Direction fixes the measured objective; language does not replace the scoring rule. One direction is evaluated per search."
msgstr "方向决定测量目标；自然语言不会替代评分规则。每次搜索只评估一个方向。"

msgid "Proposal rounds (1-4)"
msgstr "提案轮数（1～4）"

msgid "Allow paid OpenAI requests for this search"
msgstr "允许本次搜索使用付费 OpenAI 请求"

msgid "Mock mode uses deterministic fixtures, not GPT. Live requests may incur costs; cancelling an in-flight API request may still be billed."
msgstr "模拟模式使用固定测试提案，不使用 GPT。实际请求可能收费；已发出的 API 请求即使取消仍可能计费。"

msgid "Start search"
msgstr "开始搜索"

msgid "Cancel search"
msgstr "取消搜索"

msgid "Load Answer: biped, configure the bridge, then check the connection."
msgstr "加载双足机器人示例，配置桥接服务，然后检查连接。"

msgid "Evaluation history appears here (baseline, then candidates)."
msgstr "评估记录显示在此处（先基准，再候选）。"

msgid "No measured result yet."
msgstr "尚无测量结果。"

msgid "Apply best to WASD program (edit mode only)"
msgstr "将最佳结果应用于 WASD（仅编辑模式）"

msgid "Save best locally"
msgstr "保存最佳结果到本地"

msgid "Load saved best"
msgstr "加载已保存的结果"

msgid "Save/load: user://motion_lab_best.json. Stores bounded parameters, numeric metrics and assembly/controller IDs; no token, goal, model text or API key."
msgstr "保存/加载：user://motion_lab_best.json。保存限定参数、数值指标及装配和控制器标识，不保存令牌、目标、模型文本或 API 密钥。"

msgid "Checking bridge..."
msgstr "正在检查桥接服务…"

msgid "Previous start outcome is unknown. Confirm bridge status, then use Disconnect / forget before reconnecting."
msgstr "上次启动结果未知。请确认桥接服务状态，断开并清除记录后重新连接。"

msgid "A search or connection request is already active"
msgstr "搜索或连接请求已在进行。"

msgid "Check the bridge connection first"
msgstr "请先检查桥接服务连接。"

msgid "Paid OpenAI requests require explicit consent for this search"
msgstr "本次付费 OpenAI 请求需要明确同意。"

msgid "Set OPENAI_API_KEY on the bridge, not in Godot"
msgstr "请在桥接服务中设置 OPENAI_API_KEY，不要在 Godot 中设置。"

msgid "Load a valid wired biped assembly before searching"
msgstr "搜索前请加载接线有效的双足机器人。"

msgid "Goal must contain 1..2000 characters"
msgstr "目标须为 1～2000 个字符。"

msgid "No compatible motion program is configured"
msgstr "未配置兼容的动作程序。"

msgid "Evaluating the current policy as a baseline..."
msgstr "正在评估当前策略作为基准…"

msgid "No eligible result yet. Fallen or nonfinite candidates cannot be applied."
msgstr "尚无合格结果。跌倒或数值非有限的候选不可应用。"

msgid "Starting isolated baseline and candidate evaluations..."
msgstr "正在启动独立的基准和候选评估…"

msgid "Cancellation requested. An already-sent API request may still be billed."
msgstr "已请求取消。已发送的 API 请求仍可能计费。"

msgid "Waiting for the search ID, then sending cancellation. Do not start another search."
msgstr "正在等待搜索 ID，随后发送取消请求。请勿开始其他搜索。"

msgid "Unexpected bridge capabilities; no search was started"
msgstr "桥接服务能力响应异常；未开始搜索。"

msgid "MOCK - no GPT calls; real Godot physics evaluations."
msgstr "模拟模式：不调用 GPT；使用真实 Godot 物理评估。"

msgid "OPENAI - %s; key configured: %s. Explicit paid consent required."
msgstr "OPENAI - %s；密钥已配置：%s。需要明确同意付费。"

msgid "Connected. Only the selected direction will be evaluated; improvement is not guaranteed."
msgstr "已连接。仅评估所选方向，不保证改善。"

msgid "Invalid bridge result; no policy was applied"
msgstr "桥接服务结果无效；未应用策略。"

msgid "%s | evaluations: %d | API calls: %s | tokens: %s%s"
msgstr "%s | 评估：%d | API 调用：%s | 令牌：%s%s"

msgid "QUEUED"
msgstr "排队中"

msgid "BASELINE"
msgstr "基准评估中"

msgid "PROPOSING"
msgstr "提案中"

msgid "EVALUATING"
msgstr "评估中"

msgid "CANCELLING"
msgstr "取消中"

msgid "COMPLETED"
msgstr "已完成"

msgid "FAILED"
msgstr "失败"

msgid "CANCELLED"
msgstr "已取消"

msgid " Start outcome is unknown: a submitted bridge job may still run or be billed. No retry until explicit Disconnect / forget."
msgstr " 启动结果未知：已提交任务可能继续运行或计费。在手动断开并清除记录前不会重试。"

msgid " Search may still be running on the bridge; Cancel can be retried."
msgstr " 搜索可能仍在桥接服务上运行；可重试取消。"

msgid "Not connected. Check the bridge process and bearer token."
msgstr "未连接。请检查桥接进程和认证令牌。"

msgid "Disconnected. Edit connection details and check the bridge again."
msgstr "已断开。请修改连接信息并再次检查。"

msgid "No local result retained. Any remote job was NOT cancelled by disconnecting."
msgstr "未保留本地结果。断开连接并未取消远程任务。"

msgid "Local history forgotten; check the bridge before starting another paid search."
msgstr "本地记录已清除；再次付费搜索前请检查桥接服务。"

msgid "Local status cleared only. A remote search may still run or be billed; no new request was sent."
msgstr "仅清除了本地状态。远程搜索可能继续运行或计费；未发送新请求。"

msgid "Connection details changed. Check connection again."
msgstr "连接信息已更改。请重新检查连接。"

msgid "Wait for the search to finish or cancel it before applying"
msgstr "请等待搜索结束或取消后再应用。"

msgid "No finite, non-fallen evaluated policy is available"
msgstr "没有数值有限且未跌倒的已评估策略。"

msgid "Return to edit mode before applying a policy"
msgstr "应用策略前请返回编辑模式。"

msgid "Assembly changed since evaluation; search again for this exact graph"
msgstr "装配在评估后发生变化；请对当前构型重新搜索。"

msgid "Application rejected; nothing was changed"
msgstr "应用被拒绝；未作任何更改。"

msgid "Applied to the WASD joint program. Close this window and enter Run mode to try it. Source code and assembly are unchanged."
msgstr "已应用到 WASD 关节程序。关闭此窗口并进入运行模式试用。代码和装配未变。"

msgid "Baseline"
msgstr "基准"

msgid "Candidate %d"
msgstr "候选 %d"

msgid "%s: score %.3f | forward %+.2f mm | yaw %+.1f deg | fallen %s | finite %s"
msgstr "%s：得分 %.3f | 前进 %+.2f mm | 偏航 %+.1f 度 | 跌倒 %s | 有限值 %s"

msgid "Baseline evaluation is pending."
msgstr "基准评估待处理。"

msgid "Measured best: score %.4f | finite: true | fallen: false\nForward %+.4f m | lateral %+.4f m | yaw %+.3f rad\nMinimum upright %.3f | minimum height %.4f m\n%s\nA better score is not proof of walking. One direction is not a guarantee for all WASD commands."
msgstr "最佳测量结果：得分 %.4f | 有限值：是 | 跌倒：否\n前进 %+.4f m | 侧移 %+.4f m | 偏航 %+.3f rad\n最低直立度 %.3f | 最低高度 %.4f m\n%s\n高分不等于学会行走。单方向结果不保证所有 WASD 动作。"

msgid "No completed, safe result to save"
msgstr "没有已完成且安全的可保存结果。"

msgid "Could not save the result under user://"
msgstr "无法将结果保存到 user://。"

msgid "Saved bounded policy and measured metrics to %s; no credentials or prompt text."
msgstr "已将限定策略和测量指标保存至 %s；未保存认证信息或提示文本。"

msgid "No valid saved result at %s"
msgstr "%s 中没有有效的已保存结果。"

msgid "Saved result is invalid; nothing was loaded"
msgstr "保存的结果无效；未加载任何内容。"

msgid "Loaded local parameters and recorded metrics (not re-evaluated). Apply requires the exact same assembly in edit mode."
msgstr "已加载本地参数和记录指标（未重新评估）。仅能在完全相同装配的编辑模式下应用。"

msgid "true"
msgstr "是"

msgid "false"
msgstr "否"

msgid "No robot movement program configured"
msgstr "未配置机器人移动程序。"

msgid "Part deleted · Ctrl+Z to undo"
msgstr "零件已删除 · Ctrl+Z 撤销"

msgid "Transform confirmed · Ctrl+Z to undo"
msgstr "变换已确认 · Ctrl+Z 撤销"

msgid "Transform unchanged"
msgstr "变换未更改"

msgid "Transform cancelled"
msgstr "变换已取消"

msgid "Undo"
msgstr "撤销"

msgid "Redo"
msgstr "重做"

msgid "Numeric input is limited to 16 characters"
msgstr "数值输入最多 16 个字符。"

msgid "Part dimensions are fixed · Scaling is unavailable"
msgstr "零件尺寸固定 · 不可缩放"

msgid "Transform value must be finite"
msgstr "变换值必须是有限数。"

msgid "Transform exceeds the supported numeric range"
msgstr "变换值超出支持范围。"

msgid "Move"
msgstr "移动"

msgid "Rotate"
msgstr "旋转"

msgid "View"
msgstr "视图"

msgid "mouse"
msgstr "鼠标"

msgid "%s · %s · %s %s | X/Y/Z axis · Enter/LMB confirm · Esc/RMB cancel · Ctrl snap · Shift precise"
msgstr "%s · %s · %s %s | X/Y/Z 轴 · Enter/左键确认 · Esc/右键取消 · Ctrl 吸附 · Shift 精调"

msgid "Run mode is not active"
msgstr "运行模式未启用。"

msgid "Pin %d has nothing connected"
msgstr "引脚 %d 未连接任何部件。"

msgid "NameError: '%s' is not defined"
msgstr "NameError：'%s' 未定义。"

msgid "Servo '%s' is no longer available"
msgstr "舵机 '%s' 已不可用。"

msgid "SyntaxError: %s"
msgstr "语法错误：%s"

msgid "Use a loopback HTTP origin or an authenticated HTTPS origin, without a path or credentials"
msgstr "请使用本机 HTTP 或经过认证的 HTTPS 地址，不含路径或凭据。"

msgid "Endpoint port must be between 1 and 65535"
msgstr "端口须在 1～65535 之间。"

msgid "A bridge request is already in progress"
msgstr "桥接服务请求已在进行。"

msgid "Enter the bridge bearer token (24..256 printable ASCII characters), not an OpenAI API key"
msgstr "请输入桥接令牌（24～256 个可打印 ASCII 字符），而不是 OpenAI API 密钥。"

msgid "OpenAI API keys belong in the bridge environment, never in this field"
msgstr "OpenAI API 密钥应放在桥接服务环境中，不能填在此处。"

msgid "Bridge returned an invalid search ID"
msgstr "桥接服务返回了无效搜索 ID。"

msgid "Could not start the bridge request (error %d)"
msgstr "无法启动桥接请求（错误 %d）。"

msgid "Bridge connection failed, timed out or exceeded the response limit. Nothing was applied."
msgstr "桥接连接失败、超时或响应超限。未应用任何内容。"

msgid "Check token, service state and request limits."
msgstr "请检查令牌、服务状态和请求限制。"

msgid "Bridge HTTP %d: %s No automatic retry."
msgstr "桥接 HTTP %d：%s 不会自动重试。"

msgid "Bridge returned invalid JSON; nothing was applied"
msgstr "桥接服务返回了无效 JSON；未应用任何内容。"

msgid "Build a wired biped before using the movement program"
msgstr "使用移动程序前，请组装并接线双足机器人。"

msgid "Movement program needs one unambiguous biped body"
msgstr "移动程序需要且只能有一个明确的双足机身。"

msgid "No biped motion program: connect a two-leg body with four servos"
msgstr "无双足动作程序：请将双腿机身与四个舵机连接。"

msgid "Incomplete %s leg: connect hip, leg, ankle servo and foot"
msgstr "%s腿未完成：请连接髋关节、腿、踝舵机和脚掌。"

msgid "Each hip and ankle needs its own servo"
msgstr "每个髋关节和踝关节都需要独立舵机。"

msgid "Wire %s to one unambiguous board PWM pin"
msgstr "请将%s接线到唯一的开发板 PWM 引脚。"

msgid "Experimental biped joint program: forward/back and turn"
msgstr "实验性双足关节程序：前进、后退、转向"

msgid "left"
msgstr "左"

msgid "right"
msgstr "右"

msgid "left hip"
msgstr "左髋关节"

msgid "right hip"
msgstr "右髋关节"

msgid "left ankle"
msgstr "左踝关节"

msgid "right ankle"
msgstr "右踝关节"

msgid "Stop"
msgstr "停止"

msgid "Robot program"
msgstr "机器人程序"

msgid "Code"
msgstr "代码"

msgid "Controls"
msgstr "操作指南"

msgid "Python-style servo program"
msgstr "Python 风格舵机代码"

msgid "Move your robot"
msgstr "操控机器人"

msgid "W / S   Forward / backward\nA / D   Turn left / right\nSpace   Brake\nEsc   Stop input"
msgstr "W / S   前进 / 后退\nA / D   左转 / 右转\nSpace   制动\nEsc   停止输入"

msgid "Choose WASD control, then enable Run mode. Click the 3D view before using the keyboard."
msgstr "选择 WASD 控制并开启运行模式。使用键盘前请点击 3D 视图。"

msgid "Frame robot"
msgstr "聚焦机器人"

msgid "Build something that moves."
msgstr "造一个会动的机器人。"

msgid "Start with a robot example, or add parts from the library."
msgstr "从机器人示例开始，或从零件库添加零件。"

msgid "Start with a biped"
msgstr "从双足机器人开始"

msgid "Parts library"
msgstr "零件库"

msgid "Search parts..."
msgstr "搜索零件…"

msgid "All parts"
msgstr "全部零件"

msgid "Structure"
msgstr "结构件"

msgid "Actuators"
msgstr "执行器"

msgid "Electronics"
msgstr "电子元件"

msgid "No matching parts"
