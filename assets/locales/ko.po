msgid ""
msgstr ""
"Language: ko\n"
"Content-Type: text/plain; charset=UTF-8\n"
"MIME-Version: 1.0\n"

msgid "ssok - robot workshop"
msgstr "ssok - 로봇 작업실"

msgid "Language"
msgstr "언어"

msgid "Language changed, but the preference could not be saved."
msgstr "언어를 변경했지만 설정을 저장하지 못했어."

msgid "Run mode (physics)"
msgstr "실행 모드 (물리)"

msgid "Control: WASD / gamepad movement"
msgstr "조종: WASD / 게임패드 이동"

msgid "Control: Learner code"
msgstr "조종: 작성한 코드"

msgid "Run code"
msgstr "코드 실행"

msgid "Stop input / code"
msgstr "조종 / 코드 정지"

msgid "AI motion lab"
msgstr "AI 동작 실험실"

msgid "Parts"
msgstr "부품"

msgid "Delete selected"
msgstr "선택 부품 삭제"

msgid "Answer: servo arm"
msgstr "예제: 서보 팔"

msgid "Answer: biped"
msgstr "예제: 이족 로봇"

msgid "Delete selected part?"
msgstr "선택한 부품을 삭제할까?"

msgid "Remove the part and its connections? Ctrl+Z restores them."
msgstr "부품과 연결을 삭제해. Ctrl+Z로 복원할 수 있어."

msgid "OK"
msgstr "확인"

msgid "Cancel"
msgstr "취소"

msgid "Close"
msgstr "닫기"

msgid "Arduino Uno R3"
msgstr "Arduino Uno R3"

msgid "Board (placeholder)"
msgstr "보드 (임시)"

msgid "Leg Link"
msgstr "다리 링크"

msgid "Wheel 65 mm"
msgstr "바퀴 65 mm"

msgid "TT Gear Motor"
msgstr "TT 기어 모터"

msgid "HC-SR04 Ultrasonic"
msgstr "HC-SR04 초음파 센서"

msgid "Servo Angle Bracket"
msgstr "서보 앵글 브래킷"

msgid "Foot"
msgstr "발"

msgid "Chassis Plate 120 mm"
msgstr "섀시 플레이트 120 mm"

msgid "Servo Motor"
msgstr "서보 모터"

msgid "Arm Link"
msgstr "팔 링크"

msgid "Biped Body"
msgstr "이족 로봇 몸통"

msgid "Base Plate"
msgstr "베이스 플레이트"

msgid "Edit mode - select a part, then G to move or R to rotate; connections snap at ports"
msgstr "편집 모드 - 부품 선택 후 G로 이동, R로 회전. 포트끼리 가까이 두면 연결돼."

msgid "running line %d"
msgstr "%d번째 줄 실행 중"

msgid "finished"
msgstr "실행 완료"

msgid "line %d: %s"
msgstr "%d번째 줄: %s"

msgid "Added %s - G to move, R to rotate, Enter to confirm"
msgstr "%s 추가 - G 이동, R 회전, Enter 확정"

msgid "Return to edit mode and finish the current transform before deleting"
msgstr "편집 모드로 돌아가 변환을 마친 뒤 삭제해."

msgid "part removed"
msgstr "부품 삭제 완료"

msgid "click a part first, then delete it"
msgstr "먼저 삭제할 부품을 클릭해."

msgid "answer loaded - the finished servo arm"
msgstr "예제 로드 완료 - 완성된 서보 팔"

msgid "Biped loaded - Run mode for WASD / stick movement, or Run code for the stepping example"
msgstr "이족 로봇 로드 완료 - 실행 모드에서 WASD / 스틱 조종, 코드 실행으로 제자리걸음 예제"

msgid "Edit mode - G move / R rotate / X,Y,Z constrain / Esc cancel"
msgstr "편집 모드 - G 이동 / R 회전 / X,Y,Z 축 제한 / Esc 취소"

msgid "W/S forward/back · A/D turn · left stick · Space stop"
msgstr "W/S 전진·후진 · A/D 회전 · 왼쪽 스틱 · Space 정지"

msgid "Code control - press Run code; movement inputs are disabled"
msgstr "코드 조종 - 코드 실행을 눌러. 이동 입력은 꺼져 있어."

msgid "Input stopped - servos hold their last targets; return to edit mode to reset the robot"
msgstr "입력 정지 - 서보는 마지막 목표를 유지해. 편집 모드로 돌아가면 로봇이 초기화돼."

msgid "Motion lab closed. Movement remains stopped; select WASD control or toggle Run mode when ready."
msgstr "실험실을 닫았어. 조종은 정지 상태야. 준비되면 WASD 조종을 선택하거나 실행 모드를 전환해."

msgid "Evaluated parameters applied to the WASD program; assembly and learner source are unchanged"
msgstr "평가한 파라미터를 WASD 프로그램에 적용했어. 조립과 작성한 코드는 그대로야."

msgid "Assembly changed: evaluated motion parameters reset to the experimental defaults. Search again for this graph."
msgstr "조립이 바뀌어 동작 파라미터를 실험용 기본값으로 초기화했어. 현재 조립으로 다시 탐색해."

msgid "MMB orbit · Shift+MMB pan · wheel zoom · Numpad 1/3/7 views · Numpad . frame"
msgstr "마우스 중간 버튼: 시점 회전 · Shift+중간 버튼: 화면 이동 · 휠: 확대/축소 · 숫자패드 1/3/7: 시점 · 숫자패드 .: 화면 맞춤"

msgid "LMB select · G move / R rotate · X/Y/Z axis · number: mm / degrees · Enter/LMB confirm · Esc/RMB cancel · Ctrl+Z undo"
msgstr "왼쪽 클릭: 선택 · G 이동 / R 회전 · X/Y/Z 축 · 숫자: mm / 도 · Enter/왼쪽 클릭: 확정 · Esc/오른쪽 클릭: 취소 · Ctrl+Z 되돌리기"

msgid "W/S forward/back · A/D turn · left stick · Space/gamepad A brake · Esc stop input"
msgstr "W/S 전진·후진 · A/D 회전 · 왼쪽 스틱 · Space/패드 A 제동 · Esc 입력 정지"

msgid "Code control · Run code to start · Stop input / code to cancel · Esc stops"
msgstr "코드 조종 · 코드 실행으로 시작 · 조종 / 코드 정지로 취소 · Esc 정지"

msgid "Choose a control source, then enter Run mode.\nPart dimensions are fixed; G uses mm and R uses degrees."
msgstr "조종 방식을 선택하고 실행 모드를 켜.\n부품 치수는 고정이야. G는 mm, R은 도 단위야."

msgid "Code owns the motors. Keyboard/gamepad control is off."
msgstr "코드가 모터를 제어 중이야. 키보드/게임패드 조종은 꺼져 있어."

msgid "Load Answer: biped for the movement example."
msgstr "이동 예제는 '예제: 이족 로봇'을 불러와."

msgid "Keyboard ready · no gamepad detected"
msgstr "키보드 준비됨 · 게임패드 없음"

msgid "Gamepad: %s"
msgstr "게임패드: %s"

msgid "Biped demo: experimental gait (slow / drift)\nForward %+.2f · Turn %+.2f\n%s"
msgstr "이족 예제: 실험용 보행 (느림 / 표류)\n전후진 %+.2f · 회전 %+.2f\n%s"

msgid "ssok - AI motion lab"
msgstr "ssok - AI 동작 실험실"

msgid "Motion search - wired biped"
msgstr "동작 탐색 - 배선된 이족 로봇"

msgid "Propose parameters -> simulate -> compare -> explicitly apply. This does not train GPT weights. Other robot programs are not supported yet."
msgstr "파라미터 제안 → 시뮬레이션 → 비교 → 직접 적용. GPT 가중치 학습은 아니야. 다른 로봇 프로그램은 아직 지원하지 않아."

msgid "Bridge origin (loopback HTTP / deployed HTTPS)"
msgstr "브리지 주소 (로컬 HTTP / 배포된 HTTPS)"

msgid "Bridge bearer token - RAM only. Never enter an OpenAI API key here."
msgstr "브리지 인증 토큰 - 메모리에만 보관해. 여기에 OpenAI API 키를 입력하지 마."

msgid "Token from your local bridge terminal"
msgstr "로컬 브리지 터미널의 토큰"

msgid "Check connection"
msgstr "연결 확인"

msgid "Disconnect / forget"
msgstr "연결 해제 / 기록 지우기"

msgid "Recover from an unavailable bridge. Forgetting does not cancel a remote job."
msgstr "브리지 연결 문제에서 복구해. 기록을 지워도 원격 작업은 취소되지 않아."

msgid "Forget local search status?"
msgstr "로컬 탐색 상태를 지울까?"

msgid "This only disconnects the local UI. It does NOT cancel a search on the bridge.\nA submitted job may still run and API charges may continue.\nCheck or stop the bridge before starting another paid search.\nLocal connection status and pending results will be cleared."
msgstr "로컬 UI 연결만 해제해. 브리지의 탐색은 취소되지 않아.\n제출된 작업이 계속 실행되고 API 요금이 발생할 수 있어.\n다른 유료 탐색 전에 브리지를 확인하거나 중지해.\n로컬 연결 상태와 대기 중인 결과가 지워져."

msgid "Not connected. OPENAI_API_KEY is configured only on the bridge."
msgstr "연결 안 됨. OPENAI_API_KEY는 브리지에서만 설정해."

msgid "Goal (sent to the bridge/model along with this assembly snapshot)"
msgstr "목표 (조립 스냅샷과 함께 브리지/모델로 전송돼)"

msgid "Walk forward while staying upright and reducing drift"
msgstr "똑바로 서서 표류를 줄이며 앞으로 걸어가"

msgid "Evaluate: forward (W)"
msgstr "평가: 전진 (W)"

msgid "Evaluate: backward (S)"
msgstr "평가: 후진 (S)"

msgid "Evaluate: turn left (A)"
msgstr "평가: 좌회전 (A)"

msgid "Evaluate: turn right (D)"
msgstr "평가: 우회전 (D)"

msgid "Direction fixes the measured objective; language does not replace the scoring rule. One direction is evaluated per search."
msgstr "방향이 측정 목표를 정해. 자연어가 평가 규칙을 바꾸지는 않아. 한 번에 한 방향만 평가해."

msgid "Proposal rounds (1-4)"
msgstr "제안 횟수 (1~4)"

msgid "Allow paid OpenAI requests for this search"
msgstr "이번 탐색의 유료 OpenAI 요청 허용"

msgid "Mock mode uses deterministic fixtures, not GPT. Live requests may incur costs; cancelling an in-flight API request may still be billed."
msgstr "모의 모드는 GPT가 아닌 고정된 테스트 제안을 사용해. 실제 요청은 유료일 수 있고, 전송 중인 API 요청은 취소해도 과금될 수 있어."

msgid "Start search"
msgstr "탐색 시작"

msgid "Cancel search"
msgstr "탐색 취소"

msgid "Load Answer: biped, configure the bridge, then check the connection."
msgstr "'예제: 이족 로봇'을 불러오고 브리지를 설정한 뒤 연결을 확인해."

msgid "Evaluation history appears here (baseline, then candidates)."
msgstr "평가 기록이 여기에 표시돼 (기준 동작 → 후보 동작)."

msgid "No measured result yet."
msgstr "아직 측정 결과가 없어."

msgid "Apply best to WASD program (edit mode only)"
msgstr "최선 결과를 WASD에 적용 (편집 모드만)"

msgid "Save best locally"
msgstr "최선 결과 저장"

msgid "Load saved best"
msgstr "저장한 결과 불러오기"

msgid "Save/load: user://motion_lab_best.json. Stores bounded parameters, numeric metrics and assembly/controller IDs; no token, goal, model text or API key."
msgstr "저장/불러오기: user://motion_lab_best.json. 제한된 파라미터, 수치 측정값, 조립·제어기 식별값을 저장해. 토큰·목표·모델 텍스트·API 키는 저장하지 않아."

msgid "Checking bridge..."
msgstr "브리지 확인 중…"

msgid "Previous start outcome is unknown. Confirm bridge status, then use Disconnect / forget before reconnecting."
msgstr "이전 시작 요청의 결과를 알 수 없어. 브리지 상태를 확인한 뒤 연결 해제 / 기록 지우기를 하고 다시 연결해."

msgid "A search or connection request is already active"
msgstr "이미 탐색 또는 연결 요청이 진행 중이야."

msgid "Check the bridge connection first"
msgstr "먼저 브리지 연결을 확인해."

msgid "Paid OpenAI requests require explicit consent for this search"
msgstr "이번 탐색의 유료 OpenAI 요청에 직접 동의해야 해."

msgid "Set OPENAI_API_KEY on the bridge, not in Godot"
msgstr "OPENAI_API_KEY는 Godot이 아닌 브리지에 설정해."

msgid "Load a valid wired biped assembly before searching"
msgstr "탐색 전에 배선된 유효한 이족 로봇을 불러와."

msgid "Goal must contain 1..2000 characters"
msgstr "목표는 1~2000자로 입력해."

msgid "No compatible motion program is configured"
msgstr "호환되는 동작 프로그램이 없어."

msgid "Evaluating the current policy as a baseline..."
msgstr "현재 동작을 기준으로 평가 중…"

msgid "No eligible result yet. Fallen or nonfinite candidates cannot be applied."
msgstr "아직 적용할 결과가 없어. 넘어진 후보나 비정상 수치의 후보는 적용할 수 없어."

msgid "Starting isolated baseline and candidate evaluations..."
msgstr "독립 시뮬레이션으로 기준·후보 평가 시작 중…"

msgid "Cancellation requested. An already-sent API request may still be billed."
msgstr "취소를 요청했어. 이미 보낸 API 요청은 과금될 수 있어."

msgid "Waiting for the search ID, then sending cancellation. Do not start another search."
msgstr "탐색 ID를 기다린 뒤 취소 요청을 보낼게. 새 탐색은 시작하지 마."

msgid "Unexpected bridge capabilities; no search was started"
msgstr "예상하지 못한 브리지 응답이야. 탐색은 시작하지 않았어."

msgid "MOCK - no GPT calls; real Godot physics evaluations."
msgstr "모의 모드 - GPT 호출 없음. 실제 Godot 물리로 평가해."

msgid "OPENAI - %s; key configured: %s. Explicit paid consent required."
msgstr "OPENAI - %s · 키 설정: %s. 유료 요청에 직접 동의해야 해."

msgid "Connected. Only the selected direction will be evaluated; improvement is not guaranteed."
msgstr "연결됐어. 선택한 방향만 평가하며, 개선을 보장하지는 않아."

msgid "Invalid bridge result; no policy was applied"
msgstr "유효하지 않은 브리지 결과야. 동작은 적용하지 않았어."

msgid "%s | evaluations: %d | API calls: %s | tokens: %s%s"
msgstr "%s | 평가: %d | API 호출: %s | 토큰: %s%s"

msgid "QUEUED"
msgstr "대기 중"

msgid "BASELINE"
msgstr "기준 평가 중"

msgid "PROPOSING"
msgstr "후보 제안 중"

msgid "EVALUATING"
msgstr "평가 중"

msgid "CANCELLING"
msgstr "취소 중"

msgid "COMPLETED"
msgstr "완료"

msgid "FAILED"
msgstr "실패"

msgid "CANCELLED"
msgstr "취소됨"

msgid " Start outcome is unknown: a submitted bridge job may still run or be billed. No retry until explicit Disconnect / forget."
msgstr " 시작 결과를 알 수 없어. 제출한 브리지 작업은 계속 실행되거나 과금될 수 있어. 연결 해제 / 기록 지우기 전에는 재시도하지 않아."

msgid " Search may still be running on the bridge; Cancel can be retried."
msgstr " 브리지에서 탐색이 계속될 수 있어. 취소는 다시 시도할 수 있어."

msgid "Not connected. Check the bridge process and bearer token."
msgstr "연결 안 됨. 브리지 프로세스와 인증 토큰을 확인해."

msgid "Disconnected. Edit connection details and check the bridge again."
msgstr "연결 해제됨. 연결 정보를 수정하고 다시 확인해."

msgid "No local result retained. Any remote job was NOT cancelled by disconnecting."
msgstr "로컬 결과를 지웠어. 연결을 해제해도 원격 작업은 취소되지 않아."

msgid "Local history forgotten; check the bridge before starting another paid search."
msgstr "로컬 기록을 지웠어. 새 유료 탐색 전에 브리지를 확인해."

msgid "Local status cleared only. A remote search may still run or be billed; no new request was sent."
msgstr "로컬 상태만 지웠어. 원격 탐색은 계속 실행되거나 과금될 수 있어. 새 요청은 보내지 않았어."

msgid "Connection details changed. Check connection again."
msgstr "연결 정보가 바뀌었어. 다시 연결을 확인해."

msgid "Wait for the search to finish or cancel it before applying"
msgstr "탐색을 마치거나 취소한 뒤 적용해."

msgid "No finite, non-fallen evaluated policy is available"
msgstr "수치가 정상이고 넘어지지 않은 평가 결과가 없어."

msgid "Return to edit mode before applying a policy"
msgstr "동작을 적용하려면 편집 모드로 돌아가."

msgid "Assembly changed since evaluation; search again for this exact graph"
msgstr "평가 이후 조립이 바뀌었어. 현재 조립으로 다시 탐색해."

msgid "Application rejected; nothing was changed"
msgstr "적용이 거부됐어. 변경된 내용은 없어."

msgid "Applied to the WASD joint program. Close this window and enter Run mode to try it. Source code and assembly are unchanged."
msgstr "WASD 관절 프로그램에 적용했어. 창을 닫고 실행 모드에서 시험해 봐. 코드와 조립은 그대로야."

msgid "Baseline"
msgstr "기준 동작"

msgid "Candidate %d"
msgstr "후보 %d"

msgid "%s: score %.3f | forward %+.2f mm | yaw %+.1f deg | fallen %s | finite %s"
msgstr "%s: 점수 %.3f | 전진 %+.2f mm | 회전 %+.1f 도 | 넘어짐 %s | 유한값 %s"

msgid "Baseline evaluation is pending."
msgstr "기준 동작 평가 대기 중."

msgid "Measured best: score %.4f | finite: true | fallen: false\nForward %+.4f m | lateral %+.4f m | yaw %+.3f rad\nMinimum upright %.3f | minimum height %.4f m\n%s\nA better score is not proof of walking. One direction is not a guarantee for all WASD commands."
msgstr "측정한 최선 결과: 점수 %.4f | 유한값: 참 | 넘어짐: 거짓\n전진 %+.4f m | 측면 %+.4f m | 회전 %+.3f rad\n최소 직립도 %.3f | 최소 높이 %.4f m\n%s\n높은 점수가 보행의 증거는 아니야. 한 방향의 결과가 모든 WASD 동작을 보장하지 않아."

msgid "No completed, safe result to save"
msgstr "저장할 수 있는 완료된 안전한 결과가 없어."

msgid "Could not save the result under user://"
msgstr "user://에 결과를 저장하지 못했어."

msgid "Saved bounded policy and measured metrics to %s; no credentials or prompt text."
msgstr "%s에 제한된 동작과 측정값을 저장했어. 인증 정보와 프롬프트는 저장하지 않았어."

msgid "No valid saved result at %s"
msgstr "%s에 유효한 저장 결과가 없어."

msgid "Saved result is invalid; nothing was loaded"
msgstr "저장 결과가 유효하지 않아. 아무것도 불러오지 않았어."

msgid "Loaded local parameters and recorded metrics (not re-evaluated). Apply requires the exact same assembly in edit mode."
msgstr "로컬 파라미터와 측정 기록을 불러왔어 (재평가하지 않음). 같은 조립의 편집 모드에서만 적용할 수 있어."

msgid "true"
