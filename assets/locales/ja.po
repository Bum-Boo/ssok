msgstr "準備完了"

msgid "settling"
msgstr "姿勢を安定化中"

msgid "reaching"
msgstr "手を伸ばしています"

msgid "lifting"
msgstr "持ち上げ中"

msgid "holding"
msgstr "保持中"

msgid "succeeded"
msgstr "成功"

msgid "failed"
msgstr "失敗"

msgid "cancelled"
msgstr "キャンセル済み"

msgid "baseline"
msgstr "基準動作"

msgid "local"
msgstr "ローカル探索"

msgid "mock"
msgstr "模擬提案（GPT 未使用）"

msgid "openai"
msgstr "OpenAI"

msgid "replay"
msgstr "再検証"

