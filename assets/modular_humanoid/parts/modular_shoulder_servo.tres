[gd_resource type="Resource" script_class="PartDef" format=3]

[ext_resource type="ArrayMesh" path="res://assets/modular_humanoid/meshes/modular_arm_motor.res" id="1_nhdfw"]
[ext_resource type="Script" path="res://src/core/port.gd" id="2_m3xwt"]
[ext_resource type="Script" path="res://src/core/part_def.gd" id="3_k11fe"]

[sub_resource type="Resource" id="Resource_ixep0"]
script = ExtResource("2_m3xwt")
id = &"mount"
tag = &"modular_bolt"
accepts = Array[StringName]([&"modular_bolt"])

[sub_resource type="Resource" id="Resource_ged11"]
script = ExtResource("2_m3xwt")
id = &"output"
local_normal = Vector3(1, 0, 0)
tag = &"modular_output"
accepts = Array[StringName]([&"modular_output"])
rotates = true

[sub_resource type="Resource" id="Resource_kfgga"]
script = ExtResource("2_m3xwt")
id = &"signal"
kind = 1
local_position = Vector3(0, 0.01, -0.025)
tag = &"pwm_signal"
accepts = Array[StringName]([&"board_digital_pwm"])

[resource]
script = ExtResource("3_k11fe")
id = &"modular_shoulder_servo"
display_name = "Shoulder servo module (12 Nm)"
mesh = ExtResource("1_nhdfw")
ports = Array[ExtResource("2_m3xwt")]([SubResource("Resource_ixep0"), SubResource("Resource_ged11"), SubResource("Resource_kfgga")])
mass_kg = 0.1
actuator_torque_nm = 12.0
actuator_min_deg = -140.0
actuator_max_deg = 70.0
actuator_drives_connected_body = true
merge_fixed_connections = true
