[ext_resource type="Script" path="res://src/core/part_def.gd" id="3_sbtw6"]

[sub_resource type="Resource" id="Resource_eeiwx"]
script = ExtResource("2_2acd4")
id = &"mount"
tag = &"modular_bolt"
accepts = Array[StringName]([&"modular_bolt"])

[sub_resource type="Resource" id="Resource_yc1ip"]
script = ExtResource("2_2acd4")
id = &"output"
local_normal = Vector3(1, 0, 0)
tag = &"modular_output"
accepts = Array[StringName]([&"modular_output"])
rotates = true

[sub_resource type="Resource" id="Resource_ti15h"]
script = ExtResource("2_2acd4")
id = &"signal"
kind = 1
local_position = Vector3(0, 0.01, -0.034)
