[gd_resource type="Resource" script_class="PartDef" format=3]

[ext_resource type="ArrayMesh" path="res://assets/modular_humanoid/meshes/modular_arm_motor.res" id="1_mg70o"]
[ext_resource type="Script" path="res://src/core/port.gd" id="2_2twu0"]
[ext_resource type="Script" path="res://src/core/part_def.gd" id="3_jwem2"]

[sub_resource type="Resource" id="Resource_pismh"]
script = ExtResource("2_2twu0")
id = &"mount"
tag = &"modular_bolt"
accepts = Array[StringName]([&"modular_bolt"])

[sub_resource type="Resource" id="Resource_545vp"]
script = ExtResource("2_2twu0")
id = &"output"
local_normal = Vector3(1, 0, 0)
tag = &"modular_output"
accepts = Array[StringName]([&"modular_output"])
rotates = true

[sub_resource type="Resource" id="Resource_lduit"]
script = ExtResource("2_2twu0")
id = &"signal"
kind = 1
local_position = Vector3(0, 0.01, -0.025)
tag = &"pwm_signal"
accepts = Array[StringName]([&"board_digital_pwm"])

[resource]
script = ExtResource("3_jwem2")
id = &"modular_elbow_servo"
display_name = "Elbow servo module (12 Nm)"
mesh = ExtResource("1_mg70o")
ports = Array[ExtResource("2_2twu0")]([SubResource("Resource_pismh"), SubResource("Resource_545vp"), SubResource("Resource_lduit")])
mass_kg = 0.1
actuator_torque_nm = 12.0
actuator_min_deg = -140.0
actuator_max_deg = 10.0
actuator_drives_connected_body = true
merge_fixed_connections = true
