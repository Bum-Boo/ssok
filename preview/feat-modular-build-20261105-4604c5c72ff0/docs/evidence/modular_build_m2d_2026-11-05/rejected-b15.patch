diff --git a/tests/kit_robot_runtime_check.gd b/tests/kit_robot_runtime_check.gd
index f94b5ae..2b55559 100644
--- a/tests/kit_robot_runtime_check.gd
+++ b/tests/kit_robot_runtime_check.gd
@@ -46,6 +46,7 @@ func _graph_checks(graph: ConnectionGraph) -> void:
 func _run() -> void:
 	_graph_checks(KitCarPreset.build())
 	_graph_checks(KitFlagArmPreset.build())
+	_car_geometry_checks()
 	var world := Node3D.new()
 	root.add_child(world)
 	var floor_body := StaticBody3D.new()
@@ -113,3 +114,30 @@ func _run() -> void:
 	await process_frame
 	print("kit_robot_runtime_check: %d checks, %d failures" % [checks, failures])
 	quit(1 if failures else 0)
+
+
+func _car_geometry_checks() -> void:
+	var graph: ConnectionGraph = KitCarPreset.build()
+	var wheels: Array[Vector3] = []
+	var caster := Vector3.ZERO
+	var sonar_max_x: float = -INF
+	var robot_max_x: float = -INF
+	for part: Dictionary in graph.parts:
+		var definition: PartDef = part.part_def
+		if definition.wheel_radius > 0:
+			_check(definition.id == &"wheel_65", "kit car uses the legacy TT wheel hub and 65 mm wheel")
+			wheels.append(part.transform.origin)
+		if definition.id == &"ball_caster":
+			caster = part.transform.origin
+		for corner: int in 8:
+			var point: Vector3 = part.transform * definition.mesh.get_aabb().get_endpoint(corner)
+			robot_max_x = maxf(robot_max_x, point.x)
+			if definition.id == &"hc_sr04":
+				sonar_max_x = maxf(sonar_max_x, point.x)
+	_check(wheels.size() == 2, "kit car has two drive wheels")
+	if wheels.size() != 2:
+		return
+	_check(absf(caster.x - wheels[0].x - 0.0665) <= 0.003, "caster lead matches legacy within 3 mm")
+	_check(absf(caster.y - wheels[0].y + 0.0205) <= 0.003, "caster sphere height matches legacy within 3 mm")
+	_check(absf(absf(wheels[0].z - wheels[1].z) - 0.164) < 0.0001, "kit car retains legacy wheel track")
+	_check(absf(sonar_max_x - robot_max_x) < 0.0001, "sonar is the foremost robot bound")
